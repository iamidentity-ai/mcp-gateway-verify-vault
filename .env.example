# mcp-gateway-verify-vault — gateway environment
#
# Copy to .env (gitignored) and fill in your values. Everything here is a
# placeholder — no live default points at real infrastructure.

# ── Gateway host ─────────────────────────────────────────────────────────────
# Port the gateway's Express host listens on (binds 127.0.0.1).
PORT=3014
# Service name — used as the `source` on central-dashboard events, in log
# prefixes, in audit actChains, and as the MCP server identity. Override when
# running multiple gateways side by side.
GATEWAY_SERVICE_NAME=mcp-gateway

# ── Verify client secrets: where they come from (SECRETS_BACKEND) ────────────
# The gateway authenticates to IBM Verify's /oauth2/token with two OAuth client
# secrets (the Token-Exchange app, always; the agent app, only under
# AUTH_METHOD=verify). SECRETS_BACKEND selects where those secrets are read
# from. It scopes ONLY these two secrets — Vault is still used regardless for
# verify-rar ephemeral DB creds and (in AUTH_METHOD=spiffe) the actor SVID.
#
#   env   (DEFAULT) — read the plaintext secrets from the two GATEWAY_*_CLIENT_
#                     SECRET vars below. Zero extra infrastructure: the drop-in
#                     path for local evaluation.
#   vault           — read them live from the IBM Verify Vault plugin, which
#                     rotates the client_secret on every read (no plaintext
#                     secret on disk).
#
# env mode is for local evaluation — for production use vault
# (see docs/guides/secrets.md).
SECRETS_BACKEND=env

# -- env mode: the plaintext client secrets (leave blank/unset in vault mode) --
# Exchange app client_secret. Required in env mode; a missing value fails fast
# with a named error at first exchange.
GATEWAY_EXCHANGE_CLIENT_SECRET=
# Agent app client_secret. Required in env mode ONLY when AUTH_METHOD=verify.
GATEWAY_AGENT_CLIENT_SECRET=

# -- vault mode: Vault plugin role names (ignored in env mode) --
# Roles on the ibm-verify plugin mount holding the rotating client_secrets;
# the gateway reads ibm-verify/creds/<role>.
GATEWAY_EXCHANGE_ROLE=gateway-exchange
GATEWAY_AGENT_ROLE=gateway-agent

# ── IBM Verify tenant + OAuth clients ────────────────────────────────────────
# Your IBM Verify tenant base URL. The SPIFFE actor SVID audience is derived
# from this URL's host.
VERIFY_TENANT_URL=https://your-tenant.verify.ibm.com
# Token Exchange (RFC 8693) app clientId — the client that performs
# subject_token + actor_token -> OBO exchanges. (Its SECRET is resolved via
# SECRETS_BACKEND above, never set on this line.)
GATEWAY_EXCHANGE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Agent actor identity ─────────────────────────────────────────────────────
# AUTH_METHOD selects how the gateway proves ITS OWN (actor) identity in the
# token exchange:
#   spiffe (default) — mint a Vault-native JWT-SVID and present it under the
#                      custom actor token type below
#   verify           — client_credentials grant against the agent OIDC app
AUTH_METHOD=spiffe
# actor_token_type sent for the SVID — must match the name of the custom
# token type configured on the Verify tenant (bootstrap creates it).
GATEWAY_ACTOR_TOKEN_TYPE=SPIFFE
# Only needed for AUTH_METHOD=verify: the agent identity OIDC app clientId.
# (Its SECRET is resolved via SECRETS_BACKEND above.)
GATEWAY_AGENT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── HashiCorp Vault ──────────────────────────────────────────────────────────
VAULT_ADDR=http://127.0.0.1:8200
# Optional alias for VAULT_ADDR — the gateway's mint step falls back to it if set.
#VAULT_BASE_URI=
# Dev-only override: if set, used directly as the Vault client token and the
# whole SPIFFE login is skipped. Never set this in a real deployment.
#VAULT_KEY=

# AppRole used to bootstrap the workload identity (SPIFFE mode). role_id is
# not secret but is deployment-specific; secret_id IS secret — set both in
# your local .env only.
GATEWAY_APPROLE_ROLE_ID=__set_me__
GATEWAY_APPROLE_SECRET_ID=__set_me__
# Vault SPIFFE mint role — the gateway POSTs to
# /v1/spiffe/role/<GATEWAY_SPIFFE_MINT_ROLE>/mintjwt to mint its JWT-SVID.
GATEWAY_SPIFFE_MINT_ROLE=mcp-gateway
# Vault role on the native auth/spiffe mount used to exchange the SVID for a
# Vault client token.
GATEWAY_SPIFFE_AUTH_ROLE=mcp-gateway

# ── Upstream MCP server (the one being protected) ────────────────────────────
# The unmodified ("naive") MCP server the gateway fronts. The gateway injects
# Authorization: Bearer <obo> + X-DB-Username/X-DB-Password per call.
UPSTREAM_MCP_URL=http://127.0.0.1:3015/mcp

# How the OBO is presented to the upstream:
#   obo (DEFAULT)   — Authorization: Bearer <obo>. Correct for the example
#                     naive-mcp and any gateway-aware upstream that reads the OBO.
#   upstream_token  — the upstream (e.g. github/github-mcp-server) uses
#                     Authorization for ITS OWN API token. The OBO is relocated
#                     to UPSTREAM_OBO_HEADER and UPSTREAM_AUTH_TOKEN is sent in
#                     Authorization. This stops the OBO from both 401-ing the
#                     upstream AND leaking to a third-party API that must never
#                     receive it.
#UPSTREAM_AUTH_MODE=obo
# Header the OBO is relocated to in upstream_token mode (audit / a gateway-aware upstream).
#UPSTREAM_OBO_HEADER=X-Verify-OBO
# The upstream's OWN API credential, sent in Authorization in upstream_token mode
# (e.g. a GitHub PAT). SECRET — set only in your local .env.
#UPSTREAM_AUTH_TOKEN=

# ── SSF/CAEP transmitter (optional but recommended) ──────────────────────────
# Source endpoint on the SSF transmitter ("Antenna") that the gateway POSTs
# CAEP session-revoked events to. The source_id path segment must match a
# source configured on the transmitter.
ANTENNA_SOURCE_URL=https://localhost:9042/sources/agentic/events

# ── Central events dashboard (optional observability webhook) ────────────────
# When WEBHOOK_API_KEY is set, session-kills are also pushed (fire-and-forget)
# to <WEBHOOK_URL>/api/events with source=GATEWAY_SERVICE_NAME. Leave the key
# unset to disable.
WEBHOOK_URL=http://127.0.0.1:3003
#WEBHOOK_API_KEY=

# ── Tunables (defaults shown; usually leave unset) ───────────────────────────
# MFA push poll cadence + overall timeout (ms).
#MFA_POLL_INTERVAL_MS=3000
#MFA_POLL_TIMEOUT_MS=120000
# TTL for a parked HITL (mfa_challenge) transaction (ms).
#HITL_PENDING_TTL_MS=130000
# TTL for the local killed-session gate that covers transmitter -> Verify
# revocation propagation (ms).
#SSF_KILLED_SESSION_TTL_MS=300000

# ── Dev/test only ────────────────────────────────────────────────────────────
# When '1', POST /hitl/complete honors a request-body `verdict` override so
# integration scripts can drive HITL without a phone. NEVER enable outside
# local dev/CI.
#GATEWAY_ALLOW_TEST_VERDICT=0

# ── Example stack (docker-compose): Postgres + naive MCP ──────────────────────
# Only used by the bundled example (examples/naive-mcp + examples/db). Your real
# upstream MCP + database are configured however that server already is.
POSTGRES_PASSWORD=postgres_local_dev
NAIVE_PG_HOST=127.0.0.1
NAIVE_PG_PORT=5432
NAIVE_PG_DB=records
NAIVE_PG_USER=naive_admin
NAIVE_PG_PASSWORD=naive_admin_local_dev

# ══════════════════════════════════════════════════════════════════════════════
#  bootstrap/ scripts — used ONLY to stand up the Verify + Vault trust config,
#  never read by the running gateway. See bootstrap/README.md. Most values below
#  are OPTIONAL (sensible generic defaults); the required ones are marked.
# ══════════════════════════════════════════════════════════════════════════════

# ── bootstrap:verify (Verify tenant admin) ────────────────────────────────────
# Admin API client (client_credentials) allowed to manage applications,
# attributes, and access policies. REQUIRED. (VERIFY_TENANT_URL above is reused.)
VERIFY_ADMIN_CLIENT_ID=
VERIFY_ADMIN_SECRET=
# The tenant identity source the UI login app authenticates against. Strongly
# recommended — without it the UI app has no source and sign-in loops at Verify.
VERIFY_IDENTITY_SOURCE_ID=
# Optional branded login theme id (app-level customization.themeId).
#VERIFY_LOGIN_THEME_ID=
# App-body knobs (all optional; defaults shown).
#GATEWAY_APP_PREFIX=MCP Gateway
#GATEWAY_UI_ORIGIN=http://localhost:5173
#GATEWAY_COMPANY_NAME=Example
# The static agent_id claim stamped on every OBO — becomes the Vault OAuth-RS
# SUBJECT entity's external_id (one entity covers ALL users). Keep verify+vault
# in sync. (GATEWAY_ACTOR_TOKEN_TYPE above is reused.)
GATEWAY_AGENT_ID_CLAIM=mcp-gateway-agent
# The gateway's SPIFFE actor sub — the may_act constraint + Vault ACTOR
# external_id (spiffe mode). In verify mode set GATEWAY_ACTOR_SUB to the Agent
# Identity clientId instead.
GATEWAY_ACTOR_SPIFFE_SUB=spiffe://example.org/mcp-gateway
#GATEWAY_ACTOR_SUB=

# ── bootstrap:vault (Vault admin) ─────────────────────────────────────────────
# A Vault token allowed to write verify-rar roles, ACL policies, and identity
# entities. REQUIRED. (VAULT_ADDR above is reused.)
VAULT_TOKEN=
# db_name on the verify-rar roles (the Vault DB-secrets connection name).
#VAULT_RAR_DB_NAME=records
# Optional overrides for the two OAuth-RS entity names bootstrap/vault.ts creates
# (defaults are derived). SUBJECT resolves the user via the agent_id claim;
# ACTOR resolves the workload via act.sub.
#VAULT_SUBJECT_ENTITY=
#VAULT_ACTOR_ENTITY=
# Entity-alias issuer — tracks the OBO's `iss`. Defaults to VERIFY_TENANT_URL + /oauth2.
#VERIFY_ISSUER=https://your-tenant.verify.ibm.com/oauth2
# The OAuth-RS auth mount accessor. Auto-looked-up from sys/auth if unset.
#VAULT_OAUTH_RS_MOUNT_ACCESSOR=
# Runtime ACL policy name attached to the subject + actor entities.
#VAULT_RUNTIME_POLICY=records-gateway
# Only for `bootstrap:vault --with-ibm-verify` (creates the plugin roles that
# rotate the TE/agent client secrets). Needs these app ids + the client ids
# above (GATEWAY_EXCHANGE_CLIENT_ID / GATEWAY_AGENT_CLIENT_ID).
#GATEWAY_EXCHANGE_APP_ID=
#GATEWAY_AGENT_APP_ID=

# ── smoke (end-to-end proof against a running gateway) ────────────────────────
# The gateway's own base URL (it binds 127.0.0.1:PORT).
GATEWAY_URL=http://127.0.0.1:3014
# A user access_token from any OIDC login on the tenant (the RFC 8693 subject
# token). See bootstrap/smoke.ts's header for how to obtain one. REQUIRED for smoke.
SMOKE_SUBJECT_TOKEN=
# Override the seed ids the smoke test uses, if you changed examples/db/seed.sql.
#SMOKE_NONVIP_ID=REC-1001
#SMOKE_VIP_ID=REC-9001
#SMOKE_DELETE_ID=REC-1001
