{
  "rarType": "urn:example:agent:records",
  "idField": "record_id",
  "argIdKey": "recordId",
  "actions": {
    "record_read": {
      "credsPath": "verify-rar/creds/records",
      "default": true
    },
    "record_read_elevated": {
      "credsPath": "verify-rar/creds/records-elevated",
      "elevatedFrom": "record_read"
    },
    "record_write": {
      "credsPath": "verify-rar/creds/records-write"
    },
    "record_delete": {
      "blocked": true
    }
  },
  "stepUp": {
    "discoveryTools": [
      "get_record",
      "get_record_detail",
      "get_record_history"
    ],
    "probeTool": "get_record",
    "elevateWhen": {
      "field": "classification",
      "notIn": ["public", "internal"]
    }
  }
}
